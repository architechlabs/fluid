# Copy to .env for local development.
# Production installs use /etc/fluid/fluid.env.

PORT=3000
SERVER_PORT=3000
ADMIN_PIN=change-me
MAX_DEVICES=20
LOG_FILE=logs/server.log
HTTPS_REDIRECT=false
NATIVE_CAST_ENABLED=false
CAST_NAME=Fluid
NATIVE_CAST_MODE=all
AIRPLAY_ENABLED=true
# AIRPLAY_PIN=1234
MIRACAST_ENABLED=true
MIRACAST_LINK=auto
MIRACAST_RTSP_PORT=7236
MIRACAST_SCALE=1920x1080

# Optional kiosk override:
# SERVER_URL=http://localhost:3000/display.html
# CHROMIUM_BIN=/usr/bin/chromium
