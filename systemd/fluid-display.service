[Unit]
Description=Fluid Chromium Kiosk Display
After=fluid-server.service systemd-user-sessions.service
Requires=fluid-server.service

[Service]
Type=simple
User=fluid
Group=fluid
SupplementaryGroups=audio video input render tty
EnvironmentFile=/etc/fluid/fluid.env

# Wait for server to be ready
ExecStartPre=/bin/sleep 3

TTYPath=/dev/tty7
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/bin/startx /opt/fluid/start-kiosk.sh -- :0 vt7 -keeptty -nolisten tcp -nocursor
Restart=always
RestartSec=5

# Ensure display is available
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/fluid/.Xauthority

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fluid-display

[Install]
WantedBy=multi-user.target
